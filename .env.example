# =====================================================
# Mostrador — Variables de entorno
# Copia este archivo a .env.local y llena los valores.
# NUNCA pongas llaves "live"/producción aquí; es solo plantilla.
# =====================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO en API routes / Server Actions. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- IA de facturas + bot WhatsApp (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ---- Bot WhatsApp (Meta WhatsApp Cloud API) ----
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_API_TOKEN=REPLACE_ME
# Solo para el webhook externo legacy (/api/webhook/whatsapp-invoice)
WHATSAPP_WEBHOOK_SECRET=cambia-esto-por-algo-largo-y-secreto

# ---- Pagos: Wompi (sandbox para probar; cambia a prod cuando esté listo) ----
WOMPI_PUBLIC_KEY=pub_test_REPLACE_ME
WOMPI_PRIVATE_KEY=prv_test_REPLACE_ME
WOMPI_INTEGRITY_SECRET=test_integrity_REPLACE_ME
WOMPI_EVENTS_SECRET=test_events_REPLACE_ME

# ---- Bre-B / Bancolombia (solo producción; inactivo en sandbox) ----
BANCOLOMBIA_CLIENT_ID=
BANCOLOMBIA_CLIENT_SECRET=
# Debe NO contener 'sandbox' para activar la API real
BANCOLOMBIA_QR_BASE_URL=
BANCOLOMBIA_CERT_PATH=.secrets/bancolombia_cert.pem
BANCOLOMBIA_KEY_PATH=.secrets/bancolombia_key.pem
BANCOLOMBIA_WEBHOOK_SECRET=

# ---- Panel super admin (back-office) ----
# Correos con acceso a /admin, separados por coma. Solo server-side.
SUPER_ADMIN_EMAILS=jcamilouya@gmail.com

# Numero de soporte para el boton "escribenos" de la ayuda (formato 573001234567).
# Si falta, la ayuda se muestra sin el boton de WhatsApp.
NEXT_PUBLIC_SOPORTE_WHATSAPP=
